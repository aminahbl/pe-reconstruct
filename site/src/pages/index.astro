---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllSuttas } from "../lib/reconst";

const suttas = getAllSuttas();
const baseUrl = import.meta.env.BASE_URL;

const NIKAYA_ID = "DN";
---

<BaseLayout
  title="Dīgha Nikāya Peyyāla Reconstructions"
  description="Read reconstructed DN texts with English, Pali, references, and comments in a light publication interface."
>
  <main class="site-shell index">
    <header class="site-header">
      <h1 class="site-title">Dīgha Nikāya Peyyāla Reconstructions</h1>
      <p class="site-description">
        This is a demo presentation layer for composed Dīgha Nikāya suttas with
        <a
          href="https://dpdict.net/?q=peyy%C4%81la"
          target="_blank"
          rel="noopener noreferrer"
        >
          <i lang="pi">peyyāla</i>
        </a> (abridged text) reconstructions outputted by the <a
          href="https://github.com/arkiuat/pe-reconstruct"
          target="_blank"
          rel="noopener noreferrer">arkiuat/pe-reconstruct</a
        > utility. The source project is an experimental work in progress and the
        reconstructed texts may contain errors.
      </p>
      <p class="site-description">
        The original repository was forked to add a simple website interface for
        viewing reconstructed texts and this project does not develop the
        automation of
        <i lang="pi">peyyāla</i> expansion itself. Please see the main project for
        all textual and other information.
      </p>
    </header>

    <section class="index-main">
      <h2 class="sutta-grid__title">Suttas</h2>
      <div class="sutta-grid">
        {
          suttas.map((sutta) => (
            <article class="sutta-card">
              <a
                class="sutta-card__link"
                href={`${baseUrl.replace(/\/$/, "")}/dn/${sutta.slug}/`}
              >
                <p class="sutta-card__meta">
                  {NIKAYA_ID} {sutta.number}
                </p>
                <h3 class="sutta-card__title">{sutta.displayTitle}</h3>
                {sutta.paliTitle && (
                  <p class="sutta-card__body">{sutta.paliTitle}</p>
                )}
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
